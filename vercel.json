{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": true
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tz-deck.vercel.app"
        }
      ],
      "destination": "https://tzdeck.xyz/:path*",
      "permanent": true
    }
  ]
}
